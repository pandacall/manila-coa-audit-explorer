# Non-secret project settings. Copy to .env, or run scripts/setup-gcp.sh to
# create .env for you. There are no keys here: local code uses Application
# Default Credentials and the deployed app uses its service account.

GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1

# Gemini models on Vertex AI (global endpoint). Names are config so models can
# be compared on the evaluation set without code changes.
GEMINI_LOCATION=global
GEMINI_ANSWER_MODEL=gemini-3.8-flash
GEMINI_JUDGE_MODEL=gemini-3.1-pro-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Firestore question log. Documents expire 30 days after the timestamp in
# FIRESTORE_TTL_FIELD (TTL policy created by scripts/setup-gcp.sh).
FIRESTORE_LOG_COLLECTION=questions
FIRESTORE_TTL_FIELD=expire_at

# Artifact Registry Docker repository (in GCP_REGION) that CI pushes images to.
ARTIFACT_REPOSITORY=coa-explorer
