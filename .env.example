# Non-secret project settings. Copy to .env, or run scripts/setup-gcp.sh to
# create .env for you. There are no keys here: local code uses Application
# Default Credentials and the deployed app uses its service account.

GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1

# Gemini models on Vertex AI (global endpoint). Names are config so models can
# be compared on the evaluation set without code changes.
GEMINI_LOCATION=global
GEMINI_ANSWER_MODEL=gemini-3.8-flash
GEMINI_JUDGE_MODEL=gemini-3.1-pro-preview
# Reads the scanned AAPSI/APMT tables (`coa-explorer extract-aapsi`); defaults to the answer model.
# GEMINI_EXTRACTION_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Document AI OCR for the scanned short documents (`coa-explorer ocr`; multi-region, us or eu).
# Normal extract and index runs never call it. By default the project's OCR_PROCESSOR is used.
DOCUMENT_AI_LOCATION=us
# DOCUMENT_AI_PROCESSOR=projects/<number>/locations/us/processors/<id>

# Firestore question log, in its own named database (not "(default)") so it can't touch
# other apps in a shared project. Documents expire 30 days after the timestamp in
# FIRESTORE_TTL_FIELD (TTL policy created by scripts/setup-gcp.sh).
FIRESTORE_DATABASE=coa-explorer
FIRESTORE_LOG_COLLECTION=questions
FIRESTORE_TTL_FIELD=expire_at
# Rate-limit and daily-cap counters live in their own collection, which expires the same way.
FIRESTORE_LIMITS_COLLECTION=limits

# Public-demo limits: questions per visitor per hour, and questions per day across all visitors.
HOURLY_LIMIT_PER_IP=10
DAILY_QUESTION_CAP=300
# Secret that keys the hashed visitor IP in the rate-limit counters. Set the same value on every
# instance (e.g. from Secret Manager); if empty, each process picks its own at start-up.
IP_HASH_SALT=

# Artifact Registry Docker repository (in GCP_REGION) that CI pushes images to.
ARTIFACT_REPOSITORY=coa-explorer

# Evaluation (coa-explorer eval): the judge runs as a Vertex AI batch job, which reads and
# writes this Cloud Storage bucket (created by scripts/setup-gcp.sh). GEMINI_BATCH_LOCATION is
# optional: the location batch jobs run in, if it should differ from GEMINI_LOCATION.
EVAL_BATCH_BUCKET=your-project-id-coa-eval
# GEMINI_BATCH_LOCATION=
